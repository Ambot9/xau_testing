SYMBOL=XAUUSDT
BYBIT_CATEGORY=linear
GATE_CONTRACT=XAU_USDT

# Check every 60 seconds. This is enough for a 1M entry bot.
CHECK_SECONDS=60

# Your small-account risk settings.
ACCOUNT_BALANCE=50
MARGIN_USDT=5
LEVERAGE=10
MAX_RISK_USDT=0.50
MIN_RR=1.5

# Support-zone width around the latest 1H swing low.
ZONE_BUFFER_PCT=0.0012

# Prevent repeated messages for the same setup.
COOLDOWN_MINUTES=30
STATE_FILE=work/xau_alert_state.json

# Create a bot with @BotFather, then put token here.
TELEGRAM_BOT_TOKEN=put_your_bot_token_here

# Send /start to your bot, then use getUpdates to find your chat id.
TELEGRAM_CHAT_ID=put_your_chat_id_here
